# AWS server: docker-compose.prod.yml
APP_NAME=Investment RAG Lab
APP_ENV=production

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=domain_docs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=replace-with-a-long-unique-password
REDIS_HOST=redis
REDIS_PORT=6379

EMBEDDING_MODEL=hashing-384
EMBEDDING_DIM=384
# AWS에서 별도 LLM 서버를 운영하는 경우 해당 내부 주소로 변경합니다.
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
# t3.medium 기본값: 대형 로컬 LLM 대신 경량 해시 임베딩으로 Qdrant를 색인합니다.
QDRANT_URL=http://qdrant:6333
RAG_QDRANT_COLLECTION=investment_docs
LLM_MODE=extractive
RAG_EMBEDDING_PROVIDER=hash
# 외부 OpenAI 호환 LLM을 사용할 때만 설정합니다. 비밀값은 커밋하지 마세요.
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=
# :80은 EC2 공인 IP의 HTTP 접속용입니다. DNS 연결 뒤 도메인으로 변경하면 Caddy가 HTTPS를 관리합니다.
CADDY_SITE_ADDRESS=:80
UPLOAD_DIR=/app/data/uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4

# The API container reaches the LEAN Docker runner on this AWS instance over SSH.
# host.docker.internal is mapped to the AWS host by docker-compose.prod.yml.
LEAN_SSH_HOST=host.docker.internal
LEAN_SSH_USER=ubuntu
# [직접 입력] EC2 서버에 올려 둔 내 키페어 PEM 파일 이름 (예: my-key.pem) — 목록: SETUP_PLACEHOLDERS.md
LEAN_SSH_KEY_HOST_PATH=/home/ubuntu/.ssh/<SSH_KEY_FILE>
LEAN_SSH_KEY_PATH=/run/secrets/lean.pem
LEAN_REMOTE_WORKDIR=/home/ubuntu/lean-workflows
LEAN_DOCKER_IMAGE=quantconnect/lean:latest
LEAN_TIMEOUT_SECONDS=300
